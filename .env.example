# =====================================================================
# SPOTIFY TO MUZPA DOWNLOADER - ENVIRONMENT CONFIGURATION
# =====================================================================

# 1. Spotify Web API Credentials (Required)
# Create a free app at https://developer.spotify.com/dashboard
# Redirect URI can be set to: http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID="your_spotify_client_id_here"
SPOTIFY_CLIENT_SECRET="your_spotify_client_secret_here"

# 2. Muzpa Account Credentials (Optional - for automated login attempt)
# If left blank, you can log in manually once in the opened Chromium browser.
MUZPA_EMAIL=""
MUZPA_PASSWORD=""
MUZPA_BASE_URL="https://srv.muzpa.com"

# 3. Crawler & Download Settings
AUTO_MODE=false
SIMILARITY_THRESHOLD=75.0
HEADLESS=false
DOWNLOAD_TIMEOUT_SECONDS=90
PAGE_LOAD_TIMEOUT_MS=30000
MAX_RETRIES=3
RATE_LIMIT_DELAY_SECONDS=1.5

# 4. Server Configuration
HOST="127.0.0.1"
PORT=8000
